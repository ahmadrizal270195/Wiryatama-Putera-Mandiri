rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super admin = 3 email bawaan (harus SAMA dengan ADMIN_FINANCE_EMAILS di src/App.jsx)
    // ATAU akun yang role-nya "admin" (Super Admin) di menu Pengguna.
    // Aman: dokumen erp_users cuma bisa diubah oleh super admin.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email.lower() in [
              "ahmadrizal270195@gmail.com",
              "wawakhayrani@gmail.com",
              "admin@wiryatamaputera.co.id"
            ]
            || (exists(/databases/$(database)/documents/erp_users/$(request.auth.token.email.lower()))
                && get(/databases/$(database)/documents/erp_users/$(request.auth.token.email.lower())).data.role == "admin"));
    }
    function signedIn() { return request.auth != null; }
    // Staf = login DAN terdaftar di menu Pengguna (erp_users/{email})
    function isMember() {
      return isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/erp_users/$(request.auth.token.email.lower())));
    }
    function migrated() {
      return exists(/databases/$(database)/documents/erp_meta/schema)
        && get(/databases/$(database)/documents/erp_meta/schema).data.version >= 2;
    }

    // Penanda format data (dibaca sebelum login untuk tahu mode penyimpanan)
    match /erp_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daftar pengguna & hak akses: cuma super admin yang boleh ubah
    match /erp_users/{email} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Data ERP format baru (dipecah per bagian)
    match /erp_store/{key} {
      allow read: if key == "erp-products" || isMember();
      allow write: if isMember();
      match /shards/{shardId} {
        allow read: if key == "erp-products" || isMember();
        allow write: if isMember();
      }
    }

    // Data format lama. Setelah migrasi cuma bisa dibaca (jadi cadangan),
    // kecuali pengaturan aplikasi yang masih disimpan di sini.
    match /erp_data/{docId} {
      allow read: if docId == "erp-products" || (signedIn() && (!migrated() || isMember()));
      allow write: if signedIn() && (!migrated() || (docId == "erp-app-settings" && isMember()));
    }

    // Log Aktivitas Sistem: tiap anggota boleh MENULIS log atas namanya sendiri,
    // cuma super admin yang boleh MEMBACA, dan log tidak bisa diubah/dihapus siapa pun.
    match /erp_activity_logs/{logId} {
      allow create: if isMember()
        && request.resource.data.userEmail == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['userEmail', 'userName', 'userRole', 'action', 'module', 'targetLabel', 'details', 'createdAt']);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Tetap matikan pendaftaran akun di:
// Firebase Console -> Authentication -> Settings -> User actions -> "Enable create (sign-up)".
